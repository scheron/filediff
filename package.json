{
  "name": "filediff",
  "displayName": "FileDiff",
  "description": "Show Git commit history for the active file and open per-commit diffs.",
  "version": "0.0.11",
  "publisher": "InfectedByJs",
  "license": "MIT",
  "icon": "resources/logo.png",
  "repository": {
    "url": "https://github.com/scheron/filediff",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/scheron/filediff/issues"
  },
  "homepage": "https://github.com/scheron/filediff#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "diff",
    "history",
    "commits",
    "file history"
  ],
  "activationEvents": [
    "onView:filediff.commits",
    "onCommand:filediff.refresh",
    "onCommand:filediff.openCommitDiff",
    "onCommand:filediff.openFileAtCommit"
  ],
  "main": "./out/extension",
  "contributes": {
    "commands": [
      {
        "command": "filediff.refresh",
        "title": "Refresh File Commits",
        "icon": "$(refresh)"
      },
      {
        "command": "filediff.openCommitDiff",
        "title": "Open Commit Diff"
      },
      {
        "command": "filediff.openFileAtCommit",
        "title": "Open File at Commit"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "filediff",
          "title": "FileDiff",
          "icon": "resources/filediff.svg"
        }
      ]
    },
    "views": {
      "filediff": [
        {
          "type": "webview",
          "id": "filediff.commits",
          "name": "Commits"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "filediff.refresh",
          "when": "view == filediff.commits",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "vsce package",
    "publish": "vsce publish",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.5"
  }
}
